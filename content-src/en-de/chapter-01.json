{
  "id": "c01",
  "title": "Meet and identify",
  "cefr": "A1",
  "description": "Greet people, exchange basic personal details, use numbers, and follow simple classroom instructions.",
  "units": [
    {
      "id": "u01",
      "title": "Hello!",
      "canDo": "Greet people, say goodbye, and say who you are",
      "tip": {
        "title": "German has different forms of ‘you’",
        "body": "Use **ich bin** for “I am” and **du bist** with one person you know well. German changes the form of **sein** to match the subject; English usually changes only “am/is/are.”\n\nUse capitalised **Sie sind** in formal situations. **Sie** takes the same verb form as plural “they,” but the capital letter shows the polite meaning. With **heißen**, German literally says that someone “is called” a name.",
        "examples": [
          { "target": "Ich bin Mara.", "source": "I am Mara." },
          { "target": "Bist du Leon?", "source": "Are you Leon?" },
          { "target": "Sie heißen Mara.", "source": "Your name is Mara." }
        ]
      },
      "words": [
        { "id": "w-hallo", "target": "hallo", "source": "hello", "sourceAccept": ["hi"], "pos": "phrase" },
        { "id": "w-guten-morgen", "target": "guten Morgen", "source": "good morning", "pos": "phrase" },
        { "id": "w-guten-tag", "target": "guten Tag", "source": "good afternoon", "sourceAccept": ["hello", "good day"], "pos": "phrase" },
        { "id": "w-tschuess", "target": "tschüss", "source": "bye", "sourceAccept": ["goodbye", "bye-bye"], "pos": "phrase" },
        { "id": "w-auf-wiedersehen", "target": "auf Wiedersehen", "source": "goodbye", "pos": "phrase" },
        { "id": "w-ich", "target": "ich", "source": "I", "pos": "pron" },
        { "id": "w-du", "target": "du", "source": "you", "note": "informal singular", "pos": "pron" },
        { "id": "w-sie", "target": "Sie", "source": "you", "note": "formal", "pos": "pron" },
        { "id": "w-sein", "target": "sein", "source": "to be", "forms": ["bin", "bist", "ist", "sind", "seid"], "pos": "verb" },
        { "id": "w-heissen", "target": "heißen", "source": "to be called", "sourceAccept": ["to be named"], "forms": ["heiße", "heißt", "heißen"], "pos": "verb" },
        { "id": "w-und", "target": "und", "source": "and", "pos": "conj" }
      ],
      "sentences": [
        { "id": "u01-s01", "target": "Hallo, Mara!", "source": "Hello, Mara!", "targetAccept": ["Guten Tag, Mara!"], "sourceAccept": ["Hi, Mara!"], "words": ["w-hallo"] },
        { "id": "u01-s02", "target": "Hallo, ich bin Leon.", "source": "Hello, I am Leon.", "targetAccept": ["Guten Tag, ich bin Leon."], "sourceAccept": ["Hi, I am Leon.", "Hello, I'm Leon.", "Hi, I'm Leon."], "words": ["w-hallo", "w-ich", "w-sein"] },
        { "id": "u01-s03", "target": "Guten Morgen!", "source": "Good morning!", "words": ["w-guten-morgen"] },
        { "id": "u01-s04", "target": "Guten Morgen, Leon!", "source": "Good morning, Leon!", "words": ["w-guten-morgen"] },
        { "id": "u01-s05", "target": "Guten Tag!", "source": "Good afternoon!", "sourceAccept": ["Hello!", "Good day!"], "words": ["w-guten-tag"] },
        { "id": "u01-s06", "target": "Guten Tag, Mara!", "source": "Good afternoon, Mara!", "sourceAccept": ["Hello, Mara!", "Good day, Mara!"], "words": ["w-guten-tag"] },
        { "id": "u01-s07", "target": "Tschüss, Leon!", "source": "Bye, Leon!", "sourceAccept": ["Goodbye, Leon!", "Bye-bye, Leon!"], "words": ["w-tschuess"] },
        { "id": "u01-s08", "target": "Tschüss, Mara und Leon!", "source": "Bye, Mara and Leon!", "sourceAccept": ["Goodbye, Mara and Leon!", "Bye-bye, Mara and Leon!"], "words": ["w-tschuess", "w-und"] },
        { "id": "u01-s09", "target": "Auf Wiedersehen!", "source": "Goodbye!", "targetAccept": ["Tschüss!"], "words": ["w-auf-wiedersehen"] },
        { "id": "u01-s10", "target": "Auf Wiedersehen, Mara und Leon!", "source": "Goodbye, Mara and Leon!", "targetAccept": ["Tschüss, Mara und Leon!"], "words": ["w-auf-wiedersehen", "w-und"] },
        { "id": "u01-s11", "target": "Ich bin Mara.", "source": "I am Mara.", "sourceAccept": ["I'm Mara."], "words": ["w-ich", "w-sein"], "cloze": { "answer": "bin", "distractors": ["bist", "ist", "sind"] } },
        { "id": "u01-s12", "target": "Bin ich Leon?", "source": "Am I Leon?", "words": ["w-sein", "w-ich"], "cloze": { "answer": "ich", "distractors": ["du", "Sie"] } },
        { "id": "u01-s13", "target": "Du bist Leon.", "source": "You are Leon.", "targetAccept": ["Sie sind Leon."], "sourceAccept": ["You're Leon."], "words": ["w-du", "w-sein"] },
        { "id": "u01-s14", "target": "Bist du Mara?", "source": "Are you Mara?", "targetAccept": ["Sind Sie Mara?"], "words": ["w-sein", "w-du"], "cloze": { "answer": "bist", "distractors": ["bin", "sind", "seid"] } },
        { "id": "u01-s15", "target": "Sie sind Leon.", "source": "You are Leon.", "targetAccept": ["Du bist Leon."], "sourceAccept": ["You're Leon."], "words": ["w-sie", "w-sein"], "cloze": { "answer": "sind", "distractors": ["seid", "ist", "bin"] } },
        { "id": "u01-s16", "target": "Ich heiße Mara.", "source": "My name is Mara.", "sourceAccept": ["I am called Mara."], "words": ["w-ich", "w-heissen"], "cloze": { "answer": "heiße", "distractors": ["heißt", "heißen"] } },
        { "id": "u01-s17", "target": "Heißt du Leon?", "source": "Is your name Leon?", "targetAccept": ["Heißen Sie Leon?"], "sourceAccept": ["Are you called Leon?"], "words": ["w-heissen", "w-du"], "cloze": { "answer": "heißt", "distractors": ["heiße", "heißen"] } },
        { "id": "u01-s18", "target": "Sie heißen Mara.", "source": "Your name is Mara.", "targetAccept": ["Du heißt Mara."], "sourceAccept": ["You are called Mara."], "words": ["w-sie", "w-heissen"], "cloze": { "answer": "heißen", "distractors": ["heiße", "heißt"] } }
      ]
    },
    {
      "id": "u02",
      "title": "Where are you from?",
      "canDo": "Ask and answer questions about names, origins, and where people live",
      "tip": {
        "title": "Put the question word first",
        "body": "German W-questions begin with a question word, then the conjugated verb: **Wo wohnst du?** English needs “do” in many questions, but German does not.\n\nUse **wo** for location and **woher** for origin. An answer about origin uses **aus**; an answer about where someone lives normally uses **in**.",
        "examples": [
          { "target": "Wo wohnst du?", "source": "Where do you live?" },
          { "target": "Woher kommen Sie?", "source": "Where are you from?" },
          { "target": "Ich komme aus Deutschland.", "source": "I come from Germany." }
        ]
      },
      "words": [
        { "id": "w-wo", "target": "wo", "source": "where", "note": "location", "pos": "adv" },
        { "id": "w-woher", "target": "woher", "source": "where from", "sourceAccept": ["from where"], "pos": "adv" },
        { "id": "w-wie", "target": "wie", "source": "how", "pos": "adv" },
        { "id": "w-aus", "target": "aus", "source": "from", "pos": "prep" },
        { "id": "w-kommen", "target": "kommen", "source": "to come", "forms": ["komme", "kommst", "kommt", "kommen"], "pos": "verb" },
        { "id": "w-wohnen", "target": "wohnen", "source": "to live", "sourceAccept": ["to reside"], "forms": ["wohne", "wohnst", "wohnt", "wohnen"], "pos": "verb" },
        { "id": "w-deutschland", "target": "Deutschland", "source": "Germany", "pos": "other" },
        { "id": "w-england", "target": "England", "source": "England", "pos": "other" },
        { "id": "w-name", "target": "der Name", "source": "the name", "sourceAccept": ["name", "a name"], "plural": "die Namen", "pos": "noun" },
        { "id": "w-stadt", "target": "die Stadt", "source": "the city", "sourceAccept": ["city", "a city", "the town", "town", "a town"], "plural": "die Städte", "emoji": "🏙️", "pos": "noun" },
        { "id": "w-in", "target": "in", "source": "in", "pos": "prep" }
      ],
      "sentences": [
        { "id": "u02-s01", "target": "Wo bist du?", "source": "Where are you?", "targetAccept": ["Wo seid ihr?", "Wo sind Sie?"], "words": ["w-wo", "w-sein", "w-du"], "cloze": { "answer": "bist", "distractors": ["bin", "sind", "seid"] } },
        { "id": "u02-s02", "target": "Wo sind Sie?", "source": "Where are you?", "targetAccept": ["Wo bist du?", "Wo seid ihr?"], "words": ["w-wo", "w-sein", "w-sie"] },
        { "id": "u02-s03", "target": "Woher kommst du?", "source": "Where are you from?", "targetAccept": ["Woher kommt ihr?", "Woher kommen Sie?"], "words": ["w-woher", "w-kommen", "w-du"], "cloze": { "answer": "kommst", "distractors": ["komme", "kommt", "kommen"] } },
        { "id": "u02-s04", "target": "Woher kommen Sie?", "source": "Where do you come from?", "targetAccept": ["Woher kommst du?", "Woher kommt ihr?"], "sourceAccept": ["Where are you from?"], "words": ["w-woher", "w-kommen", "w-sie"] },
        { "id": "u02-s05", "target": "Ich komme aus Deutschland.", "source": "I come from Germany.", "sourceAccept": ["I am from Germany.", "I'm from Germany."], "words": ["w-ich", "w-kommen", "w-aus", "w-deutschland"], "cloze": { "answer": "aus", "distractors": ["in", "auf"] } },
        { "id": "u02-s06", "target": "Leon kommt aus England.", "source": "Leon comes from England.", "sourceAccept": ["Leon is from England.", "Leon's from England."], "words": ["w-kommen", "w-aus", "w-england"] },
        { "id": "u02-s07", "target": "Kommen Sie aus Deutschland?", "source": "Do you come from Germany?", "targetAccept": ["Kommst du aus Deutschland?", "Kommt ihr aus Deutschland?", "Sind Sie aus Deutschland?", "Bist du aus Deutschland?", "Seid ihr aus Deutschland?"], "sourceAccept": ["Are you from Germany?"], "words": ["w-kommen", "w-sie", "w-aus", "w-deutschland"], "cloze": { "answer": "kommen", "distractors": ["komme", "kommst", "kommt"] } },
        { "id": "u02-s08", "target": "Wie heißen Sie?", "source": "What is your name?", "targetAccept": ["Wie heißt du?", "Wie heißt ihr?"], "sourceAccept": ["What's your name?", "What are you called?"], "words": ["w-wie", "w-heissen", "w-sie"] },
        { "id": "u02-s09", "target": "Wie heißt die Stadt?", "source": "What is the city called?", "sourceAccept": ["What's the city called?", "What is the name of the city?", "What's the name of the city?"], "words": ["w-wie", "w-heissen", "w-stadt"], "cloze": { "answer": "wie", "distractors": ["wo", "woher"] } },
        { "id": "u02-s10", "target": "Die Stadt heißt Berlin.", "source": "The city is called Berlin.", "sourceAccept": ["The city's called Berlin.", "The name of the city is Berlin.", "The city's name is Berlin."], "words": ["w-stadt", "w-heissen"] },
        { "id": "u02-s11", "target": "Wo ist die Stadt?", "source": "Where is the city?", "sourceAccept": ["Where's the city?", "Where is the town?", "Where's the town?"], "words": ["w-wo", "w-sein", "w-stadt"] },
        { "id": "u02-s12", "target": "Ich wohne in Deutschland.", "source": "I live in Germany.", "sourceAccept": ["I reside in Germany."], "words": ["w-ich", "w-wohnen", "w-in", "w-deutschland"], "cloze": { "answer": "wohne", "distractors": ["wohnst", "wohnt", "wohnen"] } },
        { "id": "u02-s13", "target": "Wohnen Sie in England?", "source": "Do you live in England?", "targetAccept": ["Wohnst du in England?", "Wohnt ihr in England?"], "sourceAccept": ["Do you reside in England?"], "words": ["w-wohnen", "w-sie", "w-in", "w-england"] },
        { "id": "u02-s14", "target": "Wo wohnst du?", "source": "Where do you live?", "targetAccept": ["Wo wohnt ihr?", "Wo wohnen Sie?"], "sourceAccept": ["Where do you reside?"], "words": ["w-wo", "w-wohnen", "w-du"], "cloze": { "answer": "wohnst", "distractors": ["wohne", "wohnt", "wohnen"] } },
        { "id": "u02-s15", "target": "Der Name: Mara.", "source": "Name: Mara.", "sourceAccept": ["The name: Mara."], "words": ["w-name"] },
        { "id": "u02-s16", "target": "Der Name ist Leon.", "source": "The name is Leon.", "sourceAccept": ["The name's Leon."], "words": ["w-name", "w-sein"] },
        { "id": "u02-s17", "target": "Berlin ist in Deutschland.", "source": "Berlin is in Germany.", "sourceAccept": ["Berlin's in Germany."], "words": ["w-sein", "w-in", "w-deutschland"] },
        { "id": "u02-s18", "target": "Wie heißt Leon?", "source": "What is Leon's name?", "sourceAccept": ["What's Leon's name?", "What is Leon called?", "What's Leon called?"], "words": ["w-wie", "w-heissen"] }
      ]
    },
    {
      "id": "u03",
      "title": "Spell it, please",
      "canDo": "Spell a name and ask someone to repeat or speak slowly",
      "tip": {
        "title": "A polite instruction keeps Sie after the verb",
        "body": "For a polite instruction, use the verb form that goes with **Sie**, put it first, and keep **Sie** directly after it: **Sprechen Sie langsam.** English usually uses only the base verb and leaves out “you.”\n\n**Bitte** can come at the beginning or later in the instruction. **Wie bitte?** is a useful fixed question when you did not hear or understand something.",
        "examples": [
          { "target": "Buchstabieren Sie bitte.", "source": "Please spell it." },
          { "target": "Bitte sprechen Sie langsam.", "source": "Please speak slowly." },
          { "target": "Wie bitte?", "source": "Pardon?" }
        ]
      },
      "words": [
        { "id": "w-buchstabe", "target": "der Buchstabe", "source": "the letter", "sourceAccept": ["letter", "a letter"], "plural": "die Buchstaben", "pos": "noun" },
        { "id": "w-buchstabieren", "target": "buchstabieren", "source": "to spell", "forms": ["buchstabiere", "buchstabierst", "buchstabiert", "buchstabieren"], "pos": "verb" },
        { "id": "w-wiederholen", "target": "wiederholen", "source": "to repeat", "forms": ["wiederhole", "wiederholst", "wiederholt", "wiederholen"], "pos": "verb" },
        { "id": "w-bitte", "target": "bitte", "source": "please", "sourceAccept": ["you're welcome", "pardon"], "pos": "phrase" },
        { "id": "w-langsam", "target": "langsam", "source": "slowly", "sourceAccept": ["slow"], "pos": "adv" },
        { "id": "w-verstehen", "target": "verstehen", "source": "to understand", "forms": ["verstehe", "verstehst", "versteht", "verstehen"], "pos": "verb" },
        { "id": "w-sprechen", "target": "sprechen", "source": "to speak", "sourceAccept": ["to talk"], "forms": ["spreche", "sprichst", "spricht", "sprechen"], "pos": "verb" },
        { "id": "w-deutsch", "target": "Deutsch", "source": "German", "pos": "other" },
        { "id": "w-englisch", "target": "Englisch", "source": "English", "pos": "other" },
        { "id": "w-noch-einmal", "target": "noch einmal", "source": "once more", "sourceAccept": ["again", "one more time"], "pos": "phrase" },
        { "id": "w-a", "target": "A", "source": "A", "pos": "other" }
      ],
      "sentences": [
        { "id": "u03-s01", "target": "Buchstabieren Sie bitte.", "source": "Please spell it.", "targetAccept": ["Buchstabiere bitte.", "Buchstabiert bitte."], "words": ["w-buchstabieren", "w-sie", "w-bitte"], "cloze": { "answer": "Buchstabieren", "distractors": ["Buchstabiere", "Buchstabierst", "Buchstabiert"] } },
        { "id": "u03-s02", "target": "Buchstabieren Sie Mara, bitte.", "source": "Please spell Mara.", "targetAccept": ["Buchstabiere Mara, bitte.", "Buchstabiert Mara, bitte."], "words": ["w-buchstabieren", "w-sie", "w-bitte"] },
        { "id": "u03-s03", "target": "Wiederholen Sie bitte.", "source": "Please repeat that.", "targetAccept": ["Wiederhole bitte.", "Wiederholt bitte."], "sourceAccept": ["Please repeat it."], "words": ["w-wiederholen", "w-sie", "w-bitte"], "cloze": { "answer": "Wiederholen", "distractors": ["Wiederhole", "Wiederholst", "Wiederholt"] } },
        { "id": "u03-s04", "target": "Bitte wiederholen Sie langsam.", "source": "Please repeat that slowly.", "targetAccept": ["Bitte wiederhole langsam.", "Bitte wiederholt langsam."], "sourceAccept": ["Please repeat it slowly."], "words": ["w-bitte", "w-wiederholen", "w-sie", "w-langsam"] },
        { "id": "u03-s05", "target": "Sprechen Sie bitte langsam.", "source": "Please speak slowly.", "targetAccept": ["Sprich bitte langsam.", "Sprecht bitte langsam."], "sourceAccept": ["Please talk slowly."], "words": ["w-sprechen", "w-sie", "w-bitte", "w-langsam"], "cloze": { "answer": "langsam", "distractors": ["langsamer", "langsame"] } },
        { "id": "u03-s06", "target": "Sprechen Sie Deutsch?", "source": "Do you speak German?", "targetAccept": ["Sprichst du Deutsch?", "Sprecht ihr Deutsch?"], "words": ["w-sprechen", "w-sie", "w-deutsch"] },
        { "id": "u03-s07", "target": "Sprichst du Englisch?", "source": "Do you speak English?", "targetAccept": ["Sprecht ihr Englisch?", "Sprechen Sie Englisch?"], "words": ["w-sprechen", "w-du", "w-englisch"], "cloze": { "answer": "Sprichst", "distractors": ["Spreche", "Spricht", "Sprechen"] } },
        { "id": "u03-s08", "target": "Ich spreche Deutsch.", "source": "I speak German.", "words": ["w-ich", "w-sprechen", "w-deutsch"] },
        { "id": "u03-s09", "target": "Ich verstehe Deutsch.", "source": "I understand German.", "words": ["w-ich", "w-verstehen", "w-deutsch"] },
        { "id": "u03-s10", "target": "Verstehen Sie Englisch?", "source": "Do you understand English?", "targetAccept": ["Verstehst du Englisch?", "Versteht ihr Englisch?"], "words": ["w-verstehen", "w-sie", "w-englisch"], "cloze": { "answer": "Verstehen", "distractors": ["Verstehe", "Verstehst", "Versteht"] } },
        { "id": "u03-s11", "target": "Verstehen Sie?", "source": "Do you understand?", "targetAccept": ["Verstehst du?", "Versteht ihr?"], "words": ["w-verstehen", "w-sie"] },
        { "id": "u03-s12", "target": "Noch einmal, bitte.", "source": "Once more, please.", "sourceAccept": ["Again, please.", "One more time, please."], "words": ["w-noch-einmal", "w-bitte"] },
        { "id": "u03-s13", "target": "Bitte noch einmal langsam.", "source": "Please say it again slowly.", "sourceAccept": ["Please say it once more, slowly.", "Please say it one more time, slowly."], "words": ["w-bitte", "w-noch-einmal", "w-langsam"] },
        { "id": "u03-s14", "target": "Der Buchstabe heißt A.", "source": "The letter is called A.", "sourceAccept": ["The letter's called A.", "The letter is A.", "The letter's A."], "words": ["w-buchstabe", "w-heissen", "w-a"], "cloze": { "answer": "Buchstabe", "distractors": ["Buchstaben", "Buchstabieren"] } },
        { "id": "u03-s15", "target": "Ist der Buchstabe A?", "source": "Is the letter A?", "words": ["w-sein", "w-buchstabe", "w-a"] },
        { "id": "u03-s16", "target": "A, bitte.", "source": "A, please.", "words": ["w-a", "w-bitte"] },
        { "id": "u03-s17", "target": "Wie bitte?", "source": "Pardon?", "targetAccept": ["Bitte?"], "sourceAccept": ["Sorry?", "Excuse me?"], "words": ["w-wie", "w-bitte"] },
        { "id": "u03-s18", "target": "Noch einmal: A.", "source": "Once more: A.", "sourceAccept": ["Again: A.", "One more time: A."], "words": ["w-noch-einmal", "w-a"] }
      ]
