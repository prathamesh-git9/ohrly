    {
      "id": "u04",
      "title": "Numbers and age",
      "canDo": "Give your age, a number, and simple quantities",
      "tip": {
        "title": "Age uses sein, but possession uses haben",
        "body": "German asks **Wie alt bist du?** and answers **Ich bin zwanzig.** This matches English “I am twenty,” but German does not need a word for “years” in the short answer.\n\nUse **haben** for things you have: **ich habe**, **du hast**, and **Sie haben**. The question **wie viel?** asks “how much?” or “how many?” when the noun is understood.",
        "examples": [
          { "target": "Wie alt bist du?", "source": "How old are you?" },
          { "target": "Ich bin zwanzig.", "source": "I am twenty." },
          { "target": "Haben Sie die Nummer?", "source": "Do you have the number?" }
        ]
      },
      "words": [
        { "id": "w-null", "target": "null", "source": "zero", "sourceAccept": ["nil"], "pos": "num" },
        { "id": "w-eins", "target": "eins", "source": "one", "pos": "num" },
        { "id": "w-zwei", "target": "zwei", "source": "two", "pos": "num" },
        { "id": "w-zehn", "target": "zehn", "source": "ten", "pos": "num" },
        { "id": "w-zwanzig", "target": "zwanzig", "source": "twenty", "pos": "num" },
        { "id": "w-hundert", "target": "hundert", "source": "one hundred", "sourceAccept": ["a hundred", "hundred"], "pos": "num" },
        { "id": "w-alt", "target": "alt", "source": "old", "pos": "adj" },
        { "id": "w-nummer", "target": "die Nummer", "source": "the number", "sourceAccept": ["number", "a number"], "plural": "die Nummern", "emoji": "🔢", "pos": "noun" },
        { "id": "w-telefon", "target": "das Telefon", "source": "the telephone", "sourceAccept": ["telephone", "a telephone", "the phone", "phone", "a phone"], "plural": "die Telefone", "emoji": "☎️", "pos": "noun" },
        { "id": "w-haben", "target": "haben", "source": "to have", "forms": ["habe", "hast", "hat", "haben", "habt"], "pos": "verb" },
        { "id": "w-viel", "target": "viel", "source": "much", "sourceAccept": ["a lot"], "pos": "pron" },
        { "id": "w-plus", "target": "plus", "source": "plus", "pos": "conj" }
      ],
      "sentences": [
        { "id": "u04-s01", "target": "Null, eins, zwei.", "source": "Zero, one, two.", "sourceAccept": ["Nil, one, two."], "words": ["w-null", "w-eins", "w-zwei"] },
        { "id": "u04-s02", "target": "Mara ist zehn.", "source": "Mara is ten.", "sourceAccept": ["Mara is ten years old."], "words": ["w-sein", "w-zehn"], "cloze": { "answer": "zehn", "distractors": ["zwei", "zwanzig"] } },
        { "id": "u04-s03", "target": "Ich bin zwanzig.", "source": "I am twenty.", "sourceAccept": ["I'm twenty.", "I am twenty years old.", "I'm twenty years old."], "words": ["w-ich", "w-sein", "w-zwanzig"] },
