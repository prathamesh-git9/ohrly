{
  "id": "c02",
  "title": "People and everyday things",
  "cefr": "A1",
  "description": "Talk about family, identify everyday objects, discuss food and drink, describe simple actions, and correct basic information.",
  "units": [
    {
      "id": "u06",
      "title": "My family",
      "canDo": "Identify close family members and say who belongs to whom",
      "tip": {
        "title": "Possessives match the family noun",
        "body": "German possessives change to match the gender, number, and case of the noun. In the nominative, use **mein Vater** and **mein Kind**, but **meine Mutter** and **meine Eltern**. **Dein** changes in the same way. English “my” and “your” never change this way.\n\nUse **er** for a male person and **sie** for a female person. Do not confuse lowercase **sie** (“she”) with capitalised **Sie** (“you” in formal situations).",
        "examples": [
          { "target": "Das ist mein Vater.", "source": "That is my father." },
          { "target": "Meine Eltern sind verheiratet.", "source": "My parents are married." },
          { "target": "Sie ist deine Schwester.", "source": "She is your sister." }
        ]
      },
      "words": [
        { "id": "w-mein", "target": "mein", "source": "my", "forms": ["meine"], "pos": "det" },
        { "id": "w-familie", "target": "die Familie", "source": "the family", "sourceAccept": ["family", "a family"], "plural": "die Familien", "emoji": "👪", "pos": "noun" },
        { "id": "w-mutter", "target": "die Mutter", "source": "the mother", "sourceAccept": ["mother", "a mother", "the mum", "mum", "a mum", "the mom", "mom", "a mom"], "plural": "die Mütter", "pos": "noun" },
        { "id": "w-vater", "target": "der Vater", "source": "the father", "sourceAccept": ["father", "a father", "the dad", "dad", "a dad"], "plural": "die Väter", "pos": "noun" },
        { "id": "w-eltern", "target": "die Eltern", "source": "the parents", "sourceAccept": ["parents"], "plural": "die Eltern", "pos": "noun" },
        { "id": "w-bruder", "target": "der Bruder", "source": "the brother", "sourceAccept": ["brother", "a brother"], "plural": "die Brüder", "pos": "noun" },
        { "id": "w-schwester", "target": "die Schwester", "source": "the sister", "sourceAccept": ["sister", "a sister"], "plural": "die Schwestern", "pos": "noun" },
        { "id": "w-kind", "target": "das Kind", "source": "the child", "sourceAccept": ["child", "a child", "the kid", "kid", "a kid"], "plural": "die Kinder", "emoji": "🧒", "pos": "noun" },
        { "id": "w-dein", "target": "dein", "source": "your", "forms": ["deine"], "note": "informal singular", "pos": "det" },
        { "id": "w-verheiratet", "target": "verheiratet", "source": "married", "pos": "adj" },
        { "id": "w-er", "target": "er", "source": "he", "pos": "pron" },
        { "id": "w-sie-she", "target": "sie", "source": "she", "pos": "pron" }
      ],
      "sentences": [
        { "id": "u06-s01", "target": "Das ist meine Familie.", "source": "That is my family.", "sourceAccept": ["That's my family.", "This is my family."], "words": ["w-sein", "w-mein", "w-familie"] },
        { "id": "u06-s02", "target": "Sie ist meine Mutter.", "source": "She is my mother.", "sourceAccept": ["She's my mother.", "She is my mum.", "She's my mum.", "She is my mom.", "She's my mom."], "words": ["w-sie-she", "w-sein", "w-mein", "w-mutter"], "cloze": { "answer": "meine", "distractors": ["mein", "meinen", "meinem"] } },
        { "id": "u06-s03", "target": "Er ist mein Vater.", "source": "He is my father.", "sourceAccept": ["He's my father.", "He is my dad.", "He's my dad."], "words": ["w-er", "w-sein", "w-mein", "w-vater"], "cloze": { "answer": "mein", "distractors": ["meine", "meinen", "meinem"] } },
        { "id": "u06-s04", "target": "Meine Eltern wohnen in Berlin.", "source": "My parents live in Berlin.", "targetAccept": ["In Berlin wohnen meine Eltern."], "sourceAccept": ["My parents are living in Berlin."], "words": ["w-mein", "w-eltern", "w-wohnen", "w-in"] },
        { "id": "u06-s05", "target": "Mein Bruder heißt Leon.", "source": "My brother is called Leon.", "sourceAccept": ["My brother's called Leon.", "My brother is named Leon.", "My brother's name is Leon."], "words": ["w-mein", "w-bruder", "w-heissen"] },
        { "id": "u06-s06", "target": "Meine Schwester heißt Mara.", "source": "My sister is called Mara.", "sourceAccept": ["My sister's called Mara.", "My sister is named Mara.", "My sister's name is Mara."], "words": ["w-mein", "w-schwester", "w-heissen"] },
        { "id": "u06-s07", "target": "Mein Kind spricht Deutsch.", "source": "My child speaks German.", "sourceAccept": ["My child is speaking German.", "My kid speaks German.", "My kid is speaking German."], "words": ["w-mein", "w-kind", "w-sprechen", "w-deutsch"] },
        { "id": "u06-s08", "target": "Er ist verheiratet.", "source": "He is married.", "sourceAccept": ["He's married."], "words": ["w-er", "w-sein", "w-verheiratet"], "cloze": { "answer": "ist", "distractors": ["bin", "bist", "sind"] } },
        { "id": "u06-s09", "target": "Ist sie verheiratet?", "source": "Is she married?", "words": ["w-sein", "w-sie-she", "w-verheiratet"] },
        { "id": "u06-s10", "target": "Meine Eltern sind verheiratet.", "source": "My parents are married.", "sourceAccept": ["My parents are married to each other."], "words": ["w-mein", "w-eltern", "w-sein", "w-verheiratet"], "cloze": { "answer": "sind", "distractors": ["ist", "bist", "seid"] } },
        { "id": "u06-s11", "target": "Ist das deine Familie?", "source": "Is that your family?", "targetAccept": ["Ist das eure Familie?", "Ist das Ihre Familie?"], "words": ["w-sein", "w-dein", "w-familie"] },
        { "id": "u06-s12", "target": "Wie heißt deine Mutter?", "source": "What is your mother's name?", "targetAccept": ["Wie heißt eure Mutter?", "Wie heißt Ihre Mutter?"], "sourceAccept": ["What's your mother's name?", "What is your mother called?", "What's your mother called?"], "words": ["w-wie", "w-heissen", "w-dein", "w-mutter"], "cloze": { "answer": "deine", "distractors": ["dein", "deinen", "deiner"] } },
        { "id": "u06-s13", "target": "Dein Vater kommt aus England.", "source": "Your father comes from England.", "targetAccept": ["Euer Vater kommt aus England.", "Ihr Vater kommt aus England."], "sourceAccept": ["Your father is from England.", "Your father's from England."], "words": ["w-dein", "w-vater", "w-kommen", "w-aus", "w-england"] },
        { "id": "u06-s14", "target": "Wo wohnen deine Eltern?", "source": "Where do your parents live?", "targetAccept": ["Wo wohnen eure Eltern?", "Wo wohnen Ihre Eltern?"], "words": ["w-wo", "w-wohnen", "w-dein", "w-eltern"], "cloze": { "answer": "deine", "distractors": ["dein", "deinen", "deinem"] } },
        { "id": "u06-s15", "target": "Er ist dein Bruder.", "source": "He is your brother.", "targetAccept": ["Er ist euer Bruder.", "Er ist Ihr Bruder."], "sourceAccept": ["He's your brother."], "words": ["w-er", "w-sein", "w-dein", "w-bruder"] },
        { "id": "u06-s16", "target": "Sie ist deine Schwester.", "source": "She is your sister.", "targetAccept": ["Sie ist eure Schwester.", "Sie ist Ihre Schwester."], "sourceAccept": ["She's your sister."], "words": ["w-sie-she", "w-sein", "w-dein", "w-schwester"], "cloze": { "answer": "deine", "distractors": ["dein", "deinen", "deinem"] } },
        { "id": "u06-s17", "target": "Das Kind ist zehn.", "source": "The child is ten.", "sourceAccept": ["The child is ten years old.", "The kid is ten.", "The kid is ten years old."], "words": ["w-kind", "w-sein", "w-zehn"] },
        { "id": "u06-s18", "target": "Die Familie spricht Englisch.", "source": "The family speaks English.", "sourceAccept": ["The family is speaking English.", "The family speak English.", "The family are speaking English."], "words": ["w-familie", "w-sprechen", "w-englisch"] }
      ]
    },
    {
      "id": "u07",
      "title": "What is that?",
      "canDo": "Name common objects and recognise their grammatical gender",
      "tip": {
        "title": "Learn the article with every noun",
        "body": "German has three words for “the”: **der**, **die**, and **das**. The article belongs with the noun, so learn **der Tisch**, **die Tasche**, and **das Buch** as complete units. English uses “the” for all three.\n\nFor “a,” use **ein** with masculine and neuter nouns, but **eine** with feminine nouns. German plurals also vary, so learn the plural together with each new noun.",
        "examples": [
          { "target": "Das ist ein Tisch.", "source": "That is a table." },
          { "target": "Das ist eine Tasche.", "source": "That is a bag." },
          { "target": "Was ist das?", "source": "What is that?" }
        ]
      },
      "words": [
        { "id": "w-tisch", "target": "der Tisch", "source": "the table", "sourceAccept": ["table", "a table"], "plural": "die Tische", "pos": "noun" },
        { "id": "w-stuhl", "target": "der Stuhl", "source": "the chair", "sourceAccept": ["chair", "a chair"], "plural": "die Stühle", "pos": "noun" },
        { "id": "w-tasche", "target": "die Tasche", "source": "the bag", "sourceAccept": ["bag", "a bag"], "plural": "die Taschen", "emoji": "👜", "pos": "noun" },
        { "id": "w-tuer", "target": "die Tür", "source": "the door", "sourceAccept": ["door", "a door"], "plural": "die Türen", "emoji": "🚪", "pos": "noun" },
        { "id": "w-buch", "target": "das Buch", "source": "the book", "sourceAccept": ["book", "a book"], "plural": "die Bücher", "emoji": "📖", "pos": "noun" },
        { "id": "w-fenster", "target": "das Fenster", "source": "the window", "sourceAccept": ["window", "a window"], "plural": "die Fenster", "emoji": "🪟", "pos": "noun" },
        { "id": "w-ein", "target": "ein", "source": "a", "sourceAccept": ["an", "one"], "pos": "det" },
        { "id": "w-eine", "target": "eine", "source": "a", "sourceAccept": ["an", "one"], "pos": "det" },
        { "id": "w-das", "target": "das", "source": "that", "sourceAccept": ["the", "this"], "pos": "det" },
        { "id": "w-was", "target": "was", "source": "what", "pos": "pron" }
      ],
      "sentences": [
        { "id": "u07-s01", "target": "Das ist ein Tisch.", "source": "That is a table.", "sourceAccept": ["That's a table.", "This is a table."], "words": ["w-das", "w-sein", "w-ein", "w-tisch"], "cloze": { "answer": "ein", "distractors": ["eine", "einen"] } },
        { "id": "u07-s02", "target": "Ist das ein Stuhl?", "source": "Is that a chair?", "sourceAccept": ["Is this a chair?"], "words": ["w-sein", "w-das", "w-ein", "w-stuhl"] },
        { "id": "u07-s03", "target": "Das ist eine Tasche.", "source": "That is a bag.", "sourceAccept": ["That's a bag.", "This is a bag."], "words": ["w-das", "w-sein", "w-eine", "w-tasche"], "cloze": { "answer": "eine", "distractors": ["ein", "einen"] } },
        { "id": "u07-s04", "target": "Ist das eine Tür?", "source": "Is that a door?", "sourceAccept": ["Is this a door?"], "words": ["w-sein", "w-das", "w-eine", "w-tuer"] },
        { "id": "u07-s05", "target": "Das ist ein Buch.", "source": "That is a book.", "sourceAccept": ["That's a book.", "This is a book."], "words": ["w-das", "w-sein", "w-ein", "w-buch"], "cloze": { "answer": "ein", "distractors": ["eine", "einen"] } },
        { "id": "u07-s06", "target": "Das ist ein Fenster.", "source": "That is a window.", "sourceAccept": ["That's a window.", "This is a window."], "words": ["w-das", "w-sein", "w-ein", "w-fenster"] },
        { "id": "u07-s07", "target": "Das Buch ist alt.", "source": "The book is old.", "sourceAccept": ["The book's old."], "words": ["w-das", "w-buch", "w-sein", "w-alt"], "cloze": { "answer": "das", "distractors": ["der", "die"] } },
        { "id": "u07-s08", "target": "Was ist das?", "source": "What is that?", "sourceAccept": ["What's that?", "What is this?", "What's this?"], "words": ["w-was", "w-sein", "w-das"] },
        { "id": "u07-s09", "target": "Ist das ein Buch?", "source": "Is that a book?", "sourceAccept": ["Is this a book?"], "words": ["w-sein", "w-das", "w-ein", "w-buch"] },
        { "id": "u07-s10", "target": "Was ist das? Ist das eine Tasche?", "source": "What is that? Is it a bag?", "sourceAccept": ["What's that? Is it a bag?", "What is this? Is it a bag?", "What's this? Is it a bag?"], "words": ["w-was", "w-sein", "w-das", "w-eine", "w-tasche"], "cloze": { "answer": "eine", "distractors": ["ein", "einen"] } },
        { "id": "u07-s11", "target": "Der Tisch ist alt.", "source": "The table is old.", "sourceAccept": ["The table's old."], "words": ["w-tisch", "w-sein", "w-alt"] },
        { "id": "u07-s12", "target": "Ist der Stuhl alt?", "source": "Is the chair old?", "words": ["w-sein", "w-stuhl", "w-alt"] },
        { "id": "u07-s13", "target": "Ist die Tasche alt?", "source": "Is the bag old?", "words": ["w-sein", "w-tasche", "w-alt"] },
        { "id": "u07-s14", "target": "Die Tür ist alt.", "source": "The door is old.", "sourceAccept": ["The door's old."], "words": ["w-tuer", "w-sein", "w-alt"] },
        { "id": "u07-s15", "target": "Bitte öffnen Sie das Buch.", "source": "Please open the book.", "targetAccept": ["Öffnen Sie bitte das Buch.", "Öffnen Sie das Buch bitte.", "Bitte öffne das Buch.", "Öffne bitte das Buch.", "Öffne das Buch bitte.", "Bitte öffnet das Buch.", "Öffnet bitte das Buch.", "Öffnet das Buch bitte."], "sourceAccept": ["Open the book, please."], "words": ["w-bitte", "w-oeffnen", "w-sie", "w-das", "w-buch"] },
        { "id": "u07-s16", "target": "Bitte schließen Sie das Fenster.", "source": "Please close the window.", "targetAccept": ["Schließen Sie bitte das Fenster.", "Schließen Sie das Fenster bitte.", "Bitte schließe das Fenster.", "Schließe bitte das Fenster.", "Schließe das Fenster bitte.", "Bitte schließt das Fenster.", "Schließt bitte das Fenster.", "Schließt das Fenster bitte."], "sourceAccept": ["Close the window, please.", "Please shut the window.", "Shut the window, please."], "words": ["w-bitte", "w-schliessen", "w-sie", "w-das", "w-fenster"], "cloze": { "answer": "Fenster", "distractors": ["Fenstern", "Fensters"] } },
        { "id": "u07-s17", "target": "Zwei Tische, bitte.", "source": "Two tables, please.", "words": ["w-zwei", "w-tisch", "w-bitte"] },
        { "id": "u07-s18", "target": "Das ist eine Tür und das ist ein Stuhl.", "source": "That is a door, and that is a chair.", "sourceAccept": ["That's a door, and that's a chair.", "This is a door, and this is a chair."], "words": ["w-das", "w-sein", "w-eine", "w-tuer", "w-und", "w-ein", "w-stuhl"] }
      ]
    },
    {
      "id": "u08",
      "title": "Food I like",
      "canDo": "Name basic food and drink and say what you enjoy",
      "tip": {
        "title": "Use gern for things you like doing",
        "body": "German often expresses “like” with **gern** plus an action: **Ich trinke gern Tee** literally means “I drink tea gladly.” Unlike English, German does not need a separate verb meaning “like” here.\n\nFor a yes-or-no question, move the conjugated verb to the front: **Trinkst du gern Kaffee?** A food or drink can also be the subject with **schmecken**: **Der Käse schmeckt.**",
        "examples": [
          { "target": "Ich esse gern Brot.", "source": "I like eating bread." },
          { "target": "Trinkst du gern Tee?", "source": "Do you like drinking tea?" },
          { "target": "Die Milch schmeckt.", "source": "The milk tastes good." }
        ]
      },
      "words": [
        { "id": "w-brot", "target": "das Brot", "source": "the bread", "sourceAccept": ["bread", "a loaf"], "plural": "die Brote", "emoji": "🍞", "pos": "noun" },
        { "id": "w-kaese", "target": "der Käse", "source": "the cheese", "sourceAccept": ["cheese"], "plural": "die Käse", "emoji": "🧀", "pos": "noun" },
        { "id": "w-milch", "target": "die Milch", "source": "the milk", "sourceAccept": ["milk"], "plural": "die Milche", "emoji": "🥛", "pos": "noun", "note": "The technical plural for different kinds of milk; normally used in the singular." },
        { "id": "w-kaffee", "target": "der Kaffee", "source": "the coffee", "sourceAccept": ["coffee", "a coffee"], "plural": "die Kaffees", "emoji": "☕", "pos": "noun" },
        { "id": "w-tee", "target": "der Tee", "source": "the tea", "sourceAccept": ["tea", "a tea"], "plural": "die Tees", "pos": "noun" },
        { "id": "w-wasser", "target": "das Wasser", "source": "the water", "sourceAccept": ["water"], "plural": "die Wässer", "emoji": "💧", "pos": "noun" },
        { "id": "w-essen", "target": "essen", "source": "to eat", "forms": ["esse", "isst", "esst", "essen"], "pos": "verb" },
        { "id": "w-trinken", "target": "trinken", "source": "to drink", "forms": ["trinke", "trinkst", "trinkt", "trinken"], "pos": "verb" },
        { "id": "w-gern", "target": "gern", "source": "gladly", "sourceAccept": ["like to"], "pos": "adv" },
        { "id": "w-schmecken", "target": "schmecken", "source": "to taste good", "sourceAccept": ["to taste"], "forms": ["schmeckt", "schmecken"], "pos": "verb" }
      ],
      "sentences": [
        { "id": "u08-s01", "target": "Das Brot schmeckt.", "source": "The bread tastes good.", "sourceAccept": ["The bread is tasty."], "words": ["w-das", "w-brot", "w-schmecken"], "cloze": { "answer": "schmeckt", "distractors": ["schmecken", "schmecke"] } },
        { "id": "u08-s02", "target": "Das ist Käse.", "source": "That is cheese.", "sourceAccept": ["That's cheese.", "This is cheese."], "words": ["w-das", "w-sein", "w-kaese"] },
        { "id": "u08-s03", "target": "Ist das Milch?", "source": "Is that milk?", "sourceAccept": ["Is this milk?"], "words": ["w-sein", "w-das", "w-milch"] },
        { "id": "u08-s04", "target": "Wie schmeckt der Kaffee?", "source": "How does the coffee taste?", "sourceAccept": ["What does the coffee taste like?"], "words": ["w-wie", "w-schmecken", "w-kaffee"], "cloze": { "answer": "schmeckt", "distractors": ["schmecken", "schmecke"] } },
        { "id": "u08-s05", "target": "Trinkst du Tee?", "source": "Do you drink tea?", "targetAccept": ["Trinkt ihr Tee?", "Trinken Sie Tee?"], "sourceAccept": ["Are you drinking tea?"], "words": ["w-trinken", "w-du", "w-tee"] },
        { "id": "u08-s06", "target": "Ich habe Wasser.", "source": "I have water.", "sourceAccept": ["I have got water.", "I've got water."], "words": ["w-ich", "w-haben", "w-wasser"] },
        { "id": "u08-s07", "target": "Ich esse gern.", "source": "I like eating.", "sourceAccept": ["I like to eat."], "words": ["w-ich", "w-essen", "w-gern"], "cloze": { "answer": "esse", "distractors": ["isst", "esst", "essen"] } },
        { "id": "u08-s08", "target": "Isst du gern Käse?", "source": "Do you like eating cheese?", "targetAccept": ["Esst ihr gern Käse?", "Essen Sie gern Käse?"], "sourceAccept": ["Do you like to eat cheese?"], "words": ["w-essen", "w-du", "w-gern", "w-kaese"] },
        { "id": "u08-s09", "target": "Ich trinke gern Tee.", "source": "I like drinking tea.", "sourceAccept": ["I like to drink tea."], "words": ["w-ich", "w-trinken", "w-gern", "w-tee"], "cloze": { "answer": "trinke", "distractors": ["trinkst", "trinkt", "trinken"] } },
        { "id": "u08-s10", "target": "Trinkst du gern Kaffee?", "source": "Do you like drinking coffee?", "targetAccept": ["Trinkt ihr gern Kaffee?", "Trinken Sie gern Kaffee?"], "sourceAccept": ["Do you like to drink coffee?"], "words": ["w-trinken", "w-du", "w-gern", "w-kaffee"] },
        { "id": "u08-s11", "target": "Ich esse Brot.", "source": "I eat bread.", "sourceAccept": ["I am eating bread."], "words": ["w-ich", "w-essen", "w-brot"] },
        { "id": "u08-s12", "target": "Essen Sie gern Käse?", "source": "Do you like eating cheese?", "targetAccept": ["Isst du gern Käse?", "Esst ihr gern Käse?"], "sourceAccept": ["Do you like to eat cheese?"], "words": ["w-essen", "w-sie", "w-gern", "w-kaese"] },
        { "id": "u08-s13", "target": "Das Kind trinkt Milch.", "source": "The child drinks milk.", "sourceAccept": ["The child is drinking milk.", "The kid drinks milk.", "The kid is drinking milk."], "words": ["w-das", "w-kind", "w-trinken", "w-milch"], "cloze": { "answer": "trinkt", "distractors": ["trinke", "trinkst", "trinken"] } },
        { "id": "u08-s14", "target": "Mein Vater trinkt Kaffee.", "source": "My father drinks coffee.", "sourceAccept": ["My father is drinking coffee.", "My dad drinks coffee.", "My dad is drinking coffee."], "words": ["w-mein", "w-vater", "w-trinken", "w-kaffee"] },
        { "id": "u08-s15", "target": "Meine Mutter trinkt Tee.", "source": "My mother drinks tea.", "sourceAccept": ["My mother is drinking tea.", "My mum drinks tea.", "My mum is drinking tea.", "My mom drinks tea.", "My mom is drinking tea."], "words": ["w-mein", "w-mutter", "w-trinken", "w-tee"] },
        { "id": "u08-s16", "target": "Trinken Sie Wasser?", "source": "Do you drink water?", "targetAccept": ["Trinkst du Wasser?", "Trinkt ihr Wasser?"], "sourceAccept": ["Are you drinking water?"], "words": ["w-trinken", "w-sie", "w-wasser"], "cloze": { "answer": "Trinken", "distractors": ["Trinke", "Trinkst", "Trinkt"] } },
        { "id": "u08-s17", "target": "Schmecken Brot und Käse?", "source": "Do the bread and cheese taste good?", "sourceAccept": ["Are the bread and cheese tasty?"], "words": ["w-schmecken", "w-brot", "w-und", "w-kaese"] },
        { "id": "u08-s18", "target": "Kaffee und Tee, bitte.", "source": "Coffee and tea, please.", "words": ["w-kaffee", "w-und", "w-tee", "w-bitte"] }
      ]
    },
    {
      "id": "u09",
      "title": "Things we do",
      "canDo": "Describe simple present actions for different people",
      "tip": {
        "title": "The verb ending shows who acts",
        "body": "For most German verbs, remove **-en** and add an ending: **ich lerne**, **du lernst**, **er lernt**, **wir lernen**, **ihr lernt**, and **Sie lernen**. English changes far less, so the German subject and ending must agree. With stems ending in **-d** or **-t**, add an extra **e** where needed: **du arbeitest** and **ihr arbeitet**.\n\nIn a basic statement, put the conjugated verb in the second position. In a yes-or-no question, put it first: **Arbeitet ihr heute?**",
