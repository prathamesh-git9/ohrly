        { "id": "u12-s16", "target": "Brauchen Sie die Zeitung?", "source": "Do you need the newspaper?", "targetAccept": ["Brauchst du die Zeitung?", "Braucht ihr die Zeitung?"], "sourceAccept": ["Do you need the paper?"], "words": ["w-brauchen", "w-sie", "w-zeitung"], "cloze": { "answer": "Brauchen", "distractors": ["Brauche", "Brauchst", "Braucht"] } },
