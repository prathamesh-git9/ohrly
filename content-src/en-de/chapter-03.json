        { "id": "u12-s02", "target": "Brauchst du einen Apfel?", "source": "Do you need an apple?", "targetAccept": ["Braucht ihr einen Apfel?", "Brauchen Sie einen Apfel?"], "words": ["w-brauchen", "w-du", "w-einen", "w-apfel"] },
