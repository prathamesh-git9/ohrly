        { "id": "u11-s12", "target": "Ich frühstücke jeden Tag.", "source": "I eat breakfast every day.", "targetAccept": ["Jeden Tag frühstücke ich."], "sourceAccept": ["I have breakfast every day.", "I eat breakfast daily.", "I have breakfast daily."], "words": ["w-ich", "w-fruehstuecken", "w-jeden-tag"] },
