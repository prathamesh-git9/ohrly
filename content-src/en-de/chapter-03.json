        { "id": "u12-s05", "target": "Ich esse die Banane.", "source": "I am eating the banana.", "sourceAccept": ["I'm eating the banana.", "I eat the banana."], "words": ["w-ich", "w-essen", "w-banane"] },
        { "id": "u12-s06", "target": "Suchst du die Banane?", "source": "Are you looking for the banana?", "targetAccept": ["Sucht ihr die Banane?", "Suchen Sie die Banane?"], "sourceAccept": ["Are you searching for the banana?"], "words": ["w-suchen", "w-du", "w-banane"], "cloze": { "answer": "Suchst", "distractors": ["Suche", "Sucht", "Suchen"] } },
        { "id": "u12-s07", "target": "Ich lese die Zeitung.", "source": "I am reading the newspaper.", "sourceAccept": ["I'm reading the newspaper.", "I read the newspaper.", "I am reading the paper.", "I'm reading the paper.", "I read the paper."], "words": ["w-ich", "w-lesen", "w-zeitung"] },
