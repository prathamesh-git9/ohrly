        { "id": "u13-s02", "target": "Möchten Sie Kaffee oder Tee bestellen?", "source": "Would you like to order coffee or tea?", "targetAccept": ["Möchtest du Kaffee oder Tee bestellen?", "Möchtet ihr Kaffee oder Tee bestellen?"], "words": ["w-moechten", "w-sie", "w-kaffee", "w-oder", "w-tee", "w-bestellen"] },
