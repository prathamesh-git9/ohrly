        { "id": "w-fruehstueck", "target": "das Frühstück", "source": "the breakfast", "sourceAccept": ["breakfast", "a breakfast"], "plural": "die Frühstücke", "pos": "noun" },
        { "id": "w-euro", "target": "der Euro", "source": "the euro", "sourceAccept": ["euro", "a euro"], "plural": "die Euro", "emoji": "💶", "pos": "noun" },
