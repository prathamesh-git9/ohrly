        { "id": "u13-s08", "target": "Was kostet der Kaffee?", "source": "How much is the coffee?", "sourceAccept": ["What does the coffee cost?", "How much does the coffee cost?"], "words": ["w-was", "w-kosten", "w-kaffee"] },
