    {
      "id": "u12",
      "title": "I need a…",
      "canDo": "Ask for, find, and buy common everyday items",
      "tip": {
        "title": "Masculine objects change to den or einen",
        "body": "A direct object receives the action. For a masculine noun, **der** changes to **den**, and **ein** changes to **einen**: **der Apfel**, but **Ich nehme den Apfel** or **Ich suche einen Apfel**. English articles do not change this way.\n\nFeminine and neuter articles stay the same in the accusative: **die Banane**, **Ich nehme die Banane**; **das Ticket**, **Ich brauche das Ticket**.",
        "examples": [
          { "target": "Ich nehme den Saft.", "source": "I will take the juice." },
          { "target": "Ich suche einen Apfel.", "source": "I am looking for an apple." },
          { "target": "Ich brauche das Ticket.", "source": "I need the ticket." }
        ]
      },
      "words": [
        { "id": "w-suchen", "target": "suchen", "source": "to look for", "sourceAccept": ["to search for"], "forms": ["suche", "suchst", "sucht", "suchen"], "pos": "verb" },
        { "id": "w-nehmen", "target": "nehmen", "source": "to take", "forms": ["nehme", "nimmst", "nimmt", "nehmt", "nehmen"], "pos": "verb" },
        { "id": "w-apfel", "target": "der Apfel", "source": "the apple", "sourceAccept": ["apple", "an apple"], "plural": "die Äpfel", "emoji": "🍎", "pos": "noun" },
        { "id": "w-saft", "target": "der Saft", "source": "the juice", "sourceAccept": ["juice", "a juice"], "plural": "die Säfte", "emoji": "🧃", "pos": "noun" },
        { "id": "w-banane", "target": "die Banane", "source": "the banana", "sourceAccept": ["banana", "a banana"], "plural": "die Bananen", "emoji": "🍌", "pos": "noun" },
        { "id": "w-zeitung", "target": "die Zeitung", "source": "the newspaper", "sourceAccept": ["newspaper", "a newspaper", "the paper", "paper", "a paper"], "plural": "die Zeitungen", "emoji": "📰", "pos": "noun" },
        { "id": "w-ticket", "target": "das Ticket", "source": "the ticket", "sourceAccept": ["ticket", "a ticket"], "plural": "die Tickets", "emoji": "🎫", "pos": "noun" },
        { "id": "w-den", "target": "den", "source": "the", "note": "masculine accusative", "pos": "det" },
        { "id": "w-einen", "target": "einen", "source": "a", "sourceAccept": ["an", "one"], "note": "masculine accusative", "pos": "det" }
      ],
      "sentences": [
