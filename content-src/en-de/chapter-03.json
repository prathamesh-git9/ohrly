        { "id": "u13-s04", "target": "Ich lese die Speisekarte.", "source": "I am reading the menu.", "sourceAccept": ["I'm reading the menu.", "I read the menu."], "words": ["w-ich", "w-lesen", "w-speisekarte"], "cloze": { "answer": "lese", "distractors": ["liest", "lest", "lesen"] } },
