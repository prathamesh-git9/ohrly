        { "id": "u11-s07", "target": "Fährst du heute spät?", "source": "Are you travelling late today?", "targetAccept": ["Fahrt ihr heute spät?", "Fahren Sie heute spät?", "Heute fährst du spät?", "Heute fahrt ihr spät?", "Heute fahren Sie spät?"], "sourceAccept": ["Are you traveling late today?", "Are you driving late today?"], "words": ["w-fahren", "w-du", "w-heute", "w-spaet"], "cloze": { "answer": "Fährst", "distractors": ["Fahre", "Fährt", "Fahren"] } },
