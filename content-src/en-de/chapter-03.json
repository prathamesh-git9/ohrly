    {
      "id": "u13",
      "title": "At the café",
      "canDo": "Order breakfast, ask the price, and pay politely",
      "tip": {
        "title": "Ich möchte makes a polite order",
        "body": "Use **ich möchte** for a polite request: **Ich möchte einen Kaffee.** It is much closer to English “I would like” than a direct **Ich will**. With informal **du**, ask **Möchtest du ...?**; with formal **Sie**, ask **Möchten Sie ...?**\n\nThe item ordered is a direct object, so masculine **ein** becomes **einen**. To ask a price, use **Was kostet ...?** for one item and **Was kosten ...?** for more than one.",
        "examples": [
          { "target": "Ich möchte einen Kaffee.", "source": "I would like a coffee." },
          { "target": "Möchten Sie Frühstück?", "source": "Would you like breakfast?" },
          { "target": "Was kostet der Kaffee?", "source": "How much is the coffee?" }
        ]
      },
      "words": [
        { "id": "w-moechten", "target": "möchten", "source": "would like", "forms": ["möchte", "möchtest", "möchtet", "möchten"], "pos": "verb" },
        { "id": "w-bestellen", "target": "bestellen", "source": "to order", "forms": ["bestelle", "bestellst", "bestellt", "bestellen"], "pos": "verb" },
        { "id": "w-bezahlen", "target": "bezahlen", "source": "to pay", "forms": ["bezahle", "bezahlst", "bezahlt", "bezahlen"], "pos": "verb" },
        { "id": "w-kosten", "target": "kosten", "source": "to cost", "forms": ["kostet", "kosten"], "pos": "verb" },
        { "id": "w-speisekarte", "target": "die Speisekarte", "source": "the menu", "sourceAccept": ["menu", "a menu"], "plural": "die Speisekarten", "emoji": "📋", "pos": "noun" },
