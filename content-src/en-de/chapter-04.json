        { "id": "u17-s02", "target": "Wann kommt der Zug an?", "source": "When does the train arrive?", "sourceAccept": ["When is the train arriving?"], "words": ["w-wann", "w-ankommen", "w-zug"] },
        { "id": "u17-s03", "target": "Hier steige ich ein.", "source": "I get on here.", "sourceAccept": ["I am getting on here.", "I board here.", "I am boarding here."], "targetAccept": ["Ich steige hier ein."], "words": ["w-hier", "w-einsteigen", "w-ich"] },
        { "id": "u17-s04", "target": "Dort steige ich aus.", "source": "I get off there.", "sourceAccept": ["I am getting off there."], "targetAccept": ["Ich steige dort aus."], "words": ["w-dort", "w-aussteigen", "w-ich"] },
        { "id": "u17-s05", "target": "Der Zug fährt pünktlich ab.", "source": "The train leaves on time.", "sourceAccept": ["The train is leaving on time.", "The train departs on time.", "The train is departing on time."], "words": ["w-zug", "w-abfahren", "w-puenktlich"] },
        { "id": "u17-s06", "target": "Der Bus kommt spät an.", "source": "The bus arrives late.", "sourceAccept": ["The bus is arriving late."], "words": ["w-bus", "w-ankommen", "w-spaet"], "cloze": { "answer": "kommt", "distractors": ["komme", "kommst", "kommen"] } },
        { "id": "u17-s07", "target": "Die Haltestelle ist nahe.", "source": "The stop is nearby.", "sourceAccept": ["The bus stop is nearby.", "The stop is close.", "The bus stop is close."], "words": ["w-haltestelle", "w-sein", "w-nahe"] },
        { "id": "u17-s08", "target": "Wann fährt der Bus ab?", "source": "When does the bus leave?", "sourceAccept": ["When is the bus leaving?", "When does the bus depart?", "When is the bus departing?"], "words": ["w-wann", "w-bus", "w-abfahren"], "cloze": { "answer": "fährt", "distractors": ["fahre", "fährst", "fahren"] } },
        { "id": "u17-s09", "target": "Steigst du jetzt ein?", "source": "Are you getting on now?", "targetAccept": ["Steigt ihr jetzt ein?", "Steigen Sie jetzt ein?"], "sourceAccept": ["Do you get on now?", "Are you boarding now?"], "words": ["w-einsteigen", "w-du", "w-jetzt"] },
