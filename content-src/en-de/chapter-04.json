        { "id": "u17-s16", "target": "Jetzt kommt der Bus an.", "source": "The bus is arriving now.", "targetAccept": ["Der Bus kommt jetzt an."], "sourceAccept": ["The bus arrives now."], "words": ["w-jetzt", "w-ankommen", "w-bus"], "cloze": { "answer": "an", "distractors": ["aus", "auf", "ab"] } },
