    {
      "id": "u18",
      "title": "Which way?",
      "canDo": "Understand and give short directions around town",
      "tip": {
        "title": "Use short commands for directions",
        "body": "Formal German directions often use the verb first with **Sie**: **Gehen Sie geradeaus.** English directions usually omit “you,” but German keeps polite **Sie**. In everyday signs or quick instructions, you may also hear the infinitive alone.\n\nUse **zu** for a destination such as a place: **zum Bahnhof** and **zur Bank**. Use **nach** before a city or a direction without an article: **nach Berlin**, **nach links**.",
        "examples": [
          { "target": "Gehen Sie geradeaus.", "source": "Go straight ahead." },
          { "target": "Fahren Sie zum Bahnhof.", "source": "Travel to the train station." },
          { "target": "Gehen Sie nach links.", "source": "Go to the left." }
        ]
      },
      "words": [
        { "id": "w-gehen", "target": "gehen", "source": "to go", "sourceAccept": ["to walk"], "forms": ["gehe", "gehst", "geht", "gehen"], "pos": "verb" },
        { "id": "w-folgen", "target": "folgen", "source": "to follow", "forms": ["folge", "folgst", "folgt", "folgen"], "pos": "verb" },
        { "id": "w-ueber", "target": "über", "source": "across", "sourceAccept": ["over"], "pos": "prep" },
        { "id": "w-durch", "target": "durch", "source": "through", "pos": "prep" },
        { "id": "w-bis", "target": "bis", "source": "as far as", "sourceAccept": ["until", "to"], "pos": "prep" },
        { "id": "w-zu", "target": "zu", "source": "to", "forms": ["zum", "zur"], "pos": "prep" },
        { "id": "w-nach", "target": "nach", "source": "to", "sourceAccept": ["towards", "after"], "pos": "prep" },
        { "id": "w-strasse", "target": "die Straße", "source": "the street", "sourceAccept": ["street", "a street", "the road", "road", "a road"], "plural": "die Straßen", "emoji": "🛣️", "pos": "noun" },
        { "id": "w-ecke", "target": "die Ecke", "source": "the corner", "sourceAccept": ["corner", "a corner"], "plural": "die Ecken", "pos": "noun" },
        { "id": "w-weg", "target": "der Weg", "source": "the way", "sourceAccept": ["way", "a way", "the path", "path", "a path"], "plural": "die Wege", "pos": "noun" }
      ],
      "sentences": [
        { "id": "u18-s01", "target": "Gehen Sie geradeaus.", "source": "Go straight ahead.", "sourceAccept": ["Walk straight ahead.", "Go straight on.", "Walk straight on."], "words": ["w-gehen", "w-sie", "w-geradeaus"], "cloze": { "answer": "Gehen", "distractors": ["Gehe", "Gehst", "Geht"] } },
        { "id": "u18-s02", "target": "Folgen Sie der Straße.", "source": "Follow the street.", "sourceAccept": ["Follow the road."], "words": ["w-folgen", "w-sie", "w-strasse"] },
        { "id": "u18-s03", "target": "Gehen Sie über die Straße.", "source": "Go across the street.", "sourceAccept": ["Walk across the street.", "Go across the road.", "Walk across the road."], "words": ["w-gehen", "w-sie", "w-ueber", "w-strasse"] },
        { "id": "u18-s04", "target": "Fahren Sie durch die Stadt.", "source": "Travel through the city.", "sourceAccept": ["Travel through the town.", "Drive through the city.", "Go through the city."], "words": ["w-fahren", "w-sie", "w-durch", "w-stadt"] },
        { "id": "u18-s05", "target": "Gehen Sie bis zur Ecke.", "source": "Go as far as the corner.", "sourceAccept": ["Walk as far as the corner.", "Go to the corner.", "Walk to the corner."], "words": ["w-gehen", "w-sie", "w-bis", "w-zu", "w-ecke"], "cloze": { "answer": "zur", "distractors": ["zu", "zum", "der"] } },
        { "id": "u18-s06", "target": "Nehmen Sie den Bus zum Bahnhof.", "source": "Take the bus to the train station.", "sourceAccept": ["Take the bus to the railway station.", "Take the bus to the station."], "words": ["w-nehmen", "w-sie", "w-den", "w-bus", "w-zu", "w-bahnhof"] },
