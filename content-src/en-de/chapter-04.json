        { "id": "w-zug", "target": "der Zug", "source": "the train", "sourceAccept": ["train", "a train"], "plural": "die Züge", "emoji": "🚆", "pos": "noun" },
        { "id": "w-haltestelle", "target": "die Haltestelle", "source": "the stop", "sourceAccept": ["stop", "a stop", "the bus stop", "bus stop", "a bus stop"], "plural": "die Haltestellen", "pos": "noun" },
        { "id": "w-wann", "target": "wann", "source": "when", "pos": "adv" },
        { "id": "w-jetzt", "target": "jetzt", "source": "now", "pos": "adv" },
