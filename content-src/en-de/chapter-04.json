        { "id": "u18-s08", "target": "Fahren Sie heute nach Berlin.", "source": "Travel to Berlin today.", "sourceAccept": ["Go to Berlin today.", "Drive to Berlin today."], "words": ["w-fahren", "w-sie", "w-heute", "w-nach"] },
        { "id": "u18-s09", "target": "Ich suche den Weg zum Hotel.", "source": "I am looking for the way to the hotel.", "sourceAccept": ["I'm looking for the way to the hotel.", "I am looking for the path to the hotel."], "words": ["w-ich", "w-suchen", "w-den", "w-weg", "w-zu", "w-hotel"] },
        { "id": "u18-s10", "target": "Ist das der Weg zur Bank?", "source": "Is that the way to the bank?", "sourceAccept": ["Is this the way to the bank?"], "words": ["w-sein", "w-das", "w-weg", "w-zu", "w-bank"], "cloze": { "answer": "zur", "distractors": ["zum", "zu", "durch"] } },
