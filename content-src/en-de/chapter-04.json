        { "id": "u18-s17", "target": "Gehen wir über die Straße?", "source": "Are we going across the street?", "sourceAccept": ["Shall we go across the street?", "Are we walking across the street?", "Are we going across the road?"], "words": ["w-gehen", "w-wir", "w-ueber", "w-strasse"], "cloze": { "answer": "über", "distractors": ["durch", "bis", "nach"] } },
